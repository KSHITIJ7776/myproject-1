# Pull the official Nginx image
docker pull nginx

# Run Nginx container in detached mode
docker run -d --name mynginx -p 8081:80 nginx

# Verify the running container
docker ps

# Create a Docker volume
docker volume create db_data

# Pull the MySQL image
docker pull mysql:8.0

# Run MySQL container using the volume
docker run -d --name mysql-db -e MYSQL_ROOT_PASSWORD=admin -v db_data:/var/lib/mysql -p 3306:3306 mysql:8.0

# Verify the Docker volume
docker volume ls

# Inspect the MySQL container to confirm the volume mount
docker inspect mysql-db

# Create a docker-compose.yml file
cat > docker-compose.yml << 'EOF'
version: '3.8'

services:
  app:
    image: nginx
    container_name: app
    ports:
      - "8081:80"

  database:
    image: mysql:8.0
    container_name: database
    environment:
      MYSQL_ROOT_PASSWORD: admin
    volumes:
      - db_data:/var/lib/mysql
    ports:
      - "3306:3306"

volumes:
  db_data:
EOF

# Start the multi-container application
docker compose up -d

# Verify the running containers
docker compose ps

# View the docker-compose.yml file
cat docker-compose.yml

