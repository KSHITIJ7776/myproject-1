STEP 22 — CREATE Jenkinsfile
========================================================

Inside GitHub Repository

Create:

Jenkinsfile

Paste:

--------------------------------------------------------

pipeline {

    agent any

    stages {

        stage('Clone') {

            steps {

                git 'https://github.com/USERNAME/flaskapp.git'

            }
        }

        stage('Build Docker Image') {

            steps {

                sh 'docker build -t flaskapp:v1 .'

            }
        }

        stage('Run Container') {

            steps {

                sh 'docker rm -f flaskapp || true'

                sh 'docker run -d -p 5000:5000 --name flaskapp flaskapp:v1'

            }
        }
    }
}

