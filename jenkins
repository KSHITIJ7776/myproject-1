mkdir jenkins-cicd
cd jenkins-cicd
git init

cat > Jenkinsfile << 'EOF'
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Build Stage'
            }
        }

        stage('Test') {
            steps {
                echo 'Test Stage'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploy Stage'
            }
        }
    }
}
EOF

git add .
git commit -m "Initial Jenkins pipeline"
git branch -M main
git remote add origin https://github.com/<your-username>/<your-repository>.git
git push -u origin main

cat > Jenkinsfile << 'EOF'
pipeline {
    agent {
        docker {
            image 'node:14'
        }
    }

    stages {
        stage('Build') {
            steps {
                sh 'npm --version'
                echo 'Build Stage'
            }
        }

        stage('Test') {
            steps {
                echo 'Test Stage'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploy Stage'
            }
        }
    }
}
EOF

git add Jenkinsfile
git commit -m "Add Docker agent to pipeline"
git push origin main

Open Jenkins: http://localhost:8080

New Item
→ Pipeline
→ Pipeline Script from SCM
→ SCM: Git
→ Repository URL: https://github.com/<your-username>/<your-repository>.git
→ Branch: */main
→ Script Path: Jenkinsfile
→ Save
→ Build Now

To enable GitHub Webhook:
Jenkins Job
→ Configure
→ Build Triggers
→ Enable "GitHub hook trigger for GITScm polling"
→ Save

GitHub Repository
→ Settings
→ Webhooks
→ Add webhook
Payload URL: http://<your-public-ip-or-ngrok>/github-webhook/
Content-Type: application/json
Events: Just the push event
→ Add Webhook

